# Copia este archivo a .env y completa los valores reales.
# .env NUNCA debe subirse al control de versiones (ya está en .gitignore).

# OpenAI
OPENAI_API_KEY=sk-...

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=soporte_ai

# Poner en true solo para depurar queries SQL en consola
SQL_ECHO=false

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000
